<Project Sdk="Microsoft.NET.Sdk">
  <!-- A WasmKeep actor component with componentize-dotnet (preview) and
       NativeAOT-LLVM; nuget.config adds the dotnet-experimental feed the
       compiler comes from. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <AssemblyName>counter</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <PackageReference Include="runtime.linux-x64.microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bindings come from the actor world, generated on every build. -->
    <Wit Remove="**\*.wit" />
    <Wit Include="../../crates/wasmkeep-wit/wit" World="actor" />
  </ItemGroup>
</Project>
