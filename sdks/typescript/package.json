{
  "name": "@wasmkeep/sdk",
  "version": "0.3.0",
  "description": "Write WasmKeep actors in TypeScript or JavaScript.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": ["wasmkeep", "actor", "webassembly", "wasm", "component-model", "wasi", "sqlite"],
  "homepage": "https://github.com/WasmKeep/wasmkeep/tree/main/sdks/typescript#readme",
  "bugs": { "url": "https://github.com/WasmKeep/wasmkeep/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/WasmKeep/wasmkeep.git", "directory": "sdks/typescript" },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "exports": { ".": "./src/index.ts", "./front": "./src/front.ts" },
  "types": "./src/index.ts",
  "bin": { "wasmkeep-ts": "./bin/wasmkeep-ts.mjs" },
  "files": ["src", "bin", "wit", "types", "NOTICE"],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "esbuild": "0.25.12"
  },
  "overrides": {
    "@bytecodealliance/jco-std": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
